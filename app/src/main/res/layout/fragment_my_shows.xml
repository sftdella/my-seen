<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:background="@color/background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_shows_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_shows_subtitle"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- SearchBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="@string/search_hint"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@android:color/transparent"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch" />

    </LinearLayout>

    <!-- Summary Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp">

        <!-- Ingin Ditonton Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_ingin"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_inginditonton_myshows"
                android:contentDescription="Ingin Ditonton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_count_ingin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/ingin_ditonton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingin\nDitonton"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sedang Ditonton Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_sedang"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="3dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sedangditonton_myshows"
                android:contentDescription="Sedang Ditonton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_count_sedang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/sedang_ditonton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang\nDitonton"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sudah Ditonton Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_sudah"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sudahditonton_myshows"
                android:contentDescription="Sudah Ditonton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_count_sudah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/sudah_ditonton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sudah\nDitonton"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.1" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/filter_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/filter_all"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_ingin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/status_ingin"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_sedang"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/status_sedang"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_sudah"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/status_sudah"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:gravity="center" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Table Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:background="@color/white"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="@string/col_no"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/col_title"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/col_genre"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/col_rating"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:text="@string/col_status"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:text="@string/col_date"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/col_action"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_header_table"
            android:gravity="center" />

    </LinearLayout>

    <!-- Divider under header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Show List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_list"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone" />

</LinearLayout>
